{
  "name": "markdown-to-pdf-worker",
  "version": "3.0.0",
  "description": "Cloudflare Worker for rendering markdown and generating PDF",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "serve": "npx ts-node scripts/serve.ts",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "marked": "^9.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231121.0",
    "@types/dompurify": "^3.0.5",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "wrangler": "^3.14.0"
  }
}